APP_NAME=tts-openai-bridge
APP_ENV=development
HOST=0.0.0.0
PORT=8881
REQUIRE_AUTH=false

OPENAI_API_KEY=your-openai-like-key
ELEVENLABS_API_KEY=your-elevenlabs-key
GOOGLE_TTS_API_KEY=your-google-key
AZURE_SPEECH_KEY=your-azure-key
AZURE_SPEECH_REGION=eastus

VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_API_KEY=
VOICEBOX_DEFAULT_PROFILE_ID=
DEFAULT_PROVIDER=tts-bridge/voicebox
